# Gemini server secret
GEMINI_API_KEY=""

# Public application URL used for OAuth/email redirects
PUBLIC_APP_URL="https://YOUR-DOMAIN"
APP_URL="https://YOUR-DOMAIN"

# Supabase browser-safe configuration
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# Server-only WhatsApp gateway configuration (use HTTPS in production)
WHATSAPP_SERVER_URL="https://YOUR-WHATSAPP-GATEWAY"
WHATSAPP_API_KEY=""

# Server-only signed-session secret (generate a long random value)
AUTH_TOKEN_SECRET=""

# SMTP server-only configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""

# Admin configuration
OFFICIAL_ADMIN_EMAIL="hasstysupport@gmail.com"
ADMIN_ROUTE_PREFIX="/sys-ctrl-98xf-vault"
