# Gemini server secret
GEMINI_API_KEY=""

# Public application URL used for OAuth/email redirects and GREEN API webhook
APP_URL="https://hassty.vercel.app"

# Supabase browser-safe configuration
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY=""

# Supabase server-only service role key (required by WhatsApp event/webhook routes)
SUPABASE_SERVICE_ROLE_KEY=""

# Server-only signed-session / auth secrets
AUTH_TOKEN_SECRET=""
AUTH_CODE_PEPPER=""

# GREEN API — server-only credentials
GREEN_API_URL="https://YOUR-INSTANCE.api.greenapi.com"
GREEN_API_INSTANCE_ID=""
GREEN_API_TOKEN=""
GREEN_API_WEBHOOK_TOKEN=""
WHATSAPP_INTERNAL_SECRET=""
GREEN_API_SEND_DELAY_MS="700"

# Web Push (browser notifications) — server-only VAPID keys
# Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@example.com"

# SMTP server-only configuration
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
