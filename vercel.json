{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "http://54.85.197.100:3000/api/v1/:path*"
    },
    {
      "source": "/api/auth/register",
      "destination": "/api/auth/register"
    },
    {
      "source": "/api/auth/verify-code",
      "destination": "/api/auth/verify-code"
    },
    {
      "source": "/api/auth/send-code",
      "destination": "/api/auth/send-code"
    },
    {
      "source": "/api/auth/login-check",
      "destination": "/api/auth/login-check"
    },
    {
      "source": "/api/auth/reset-password",
      "destination": "/api/auth/reset-password"
    },
    {
      "source": "/api/auth/profile-complete",
      "destination": "/api/auth/profile-complete"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
