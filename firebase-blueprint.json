{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account representing a student, parent, teacher, or admin",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "phone": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "parent", "teacher", "admin"] },
        "status": { "type": "string", "enum": ["active", "suspended", "pending"] },
        "badge": { "type": "string", "enum": ["verified", "featured", "suspicious", "fraudulent", "none"] },
        "governorate": { "type": "string" },
        "area": { "type": "string" },
        "subject": { "type": "string" },
        "grade": { "type": "string" },
        "studentsCount": { "type": "number" },
        "totalRevenue": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "phone", "name", "role"]
    },
    "TeacherVerificationRequest": {
      "title": "TeacherVerificationRequest",
      "description": "Teacher credentials submitted for admin review and badge granting",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "phone": { "type": "string" },
        "nationalId": { "type": "string" },
        "subject": { "type": "string" },
        "stage": { "type": "string" },
        "governorate": { "type": "string" },
        "area": { "type": "string" },
        "nationalIdFrontUrl": { "type": "string" },
        "nationalIdBackUrl": { "type": "string" },
        "syndicateCardUrl": { "type": "string" },
        "degreeCertUrl": { "type": "string" },
        "submittedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "actionedAt": { "type": "string" },
        "actionedBy": { "type": "string" },
        "rejectionReason": { "type": "string" }
      },
      "required": ["id", "teacherId", "teacherName", "phone", "nationalId", "status"]
    },
    "SafetyReport": {
      "title": "SafetyReport",
      "description": "Incident or misconduct report filed against a tutor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reporterName": { "type": "string" },
        "reporterRole": { "type": "string" },
        "reporterPhone": { "type": "string" },
        "reportedTeacherId": { "type": "string" },
        "reportedTeacherName": { "type": "string" },
        "reportedTeacherPhone": { "type": "string" },
        "category": { "type": "string" },
        "severity": { "type": "string", "enum": ["high", "medium", "low"] },
        "description": { "type": "string" },
        "submittedAt": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "in_review", "resolved"] },
        "teacherSuspended": { "type": "boolean" }
      },
      "required": ["id", "reporterName", "reportedTeacherId", "category", "severity", "status"]
    },
    "CommissionRecord": {
      "title": "CommissionRecord",
      "description": "Monthly commission calculation and collection tracking per teacher",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "phone": { "type": "string" },
        "governorate": { "type": "string" },
        "tier": { "type": "string" },
        "activeStudentsCount": { "type": "number" },
        "grossRevenueEGP": { "type": "number" },
        "commissionRatePercent": { "type": "number" },
        "commissionDueEGP": { "type": "number" },
        "paymentStatus": { "type": "string", "enum": ["paid", "pending", "overdue"] },
        "lastPaymentDate": { "type": "string" }
      },
      "required": ["id", "teacherId", "teacherName", "grossRevenueEGP", "commissionDueEGP", "paymentStatus"]
    },
    "ParentLinkRequest": {
      "title": "ParentLinkRequest",
      "description": "Linking request between a parent account and student with approval workflow",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "parentId": { "type": "string" },
        "parentName": { "type": "string" },
        "parentPhone": { "type": "string" },
        "parentEmail": { "type": "string" },
        "parentAvatarUrl": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentCode": { "type": "string" },
        "studentGrade": { "type": "string" },
        "studentAvatarUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string" },
        "respondedAt": { "type": "string" },
        "declineReason": { "type": "string" }
      },
      "required": ["id", "parentId", "parentName", "studentId", "studentCode", "status", "createdAt"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "Collection of all student, teacher, parent, and admin accounts"
    },
    "parent_link_requests": {
      "schema": "ParentLinkRequest",
      "description": "Requests from parents to link their accounts with student profiles"
    },
    "tutors": {
      "schema": "User",
      "description": "Tutor directory profiles for search and booking"
    },
    "verification_requests": {
      "schema": "TeacherVerificationRequest",
      "description": "Verification queue submitted by teachers with documents"
    },
    "safety_reports": {
      "schema": "SafetyReport",
      "description": "Safety and complaint reports filed on the platform"
    },
    "commissions": {
      "schema": "CommissionRecord",
      "description": "Monthly platform commission and collection records"
    }
  }
}
